# =============================================================================
# Myhr Tre og Design – AI Social Media Manager
# Kopier til .env.local (lokalt) eller legg inn i Vercel → Settings → Environment Variables.
# ALDRI legg ekte verdier i Git.
# =============================================================================

# --- Supabase (Project Settings → API) ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://DITT-PROSJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Hemmelig! Kun server-side. Brukes til krypterte Facebook-tokens, planlagt publisering og signerte bilde-URL-er.
SUPABASE_SERVICE_ROLE_KEY=

# --- Applikasjon --------------------------------------------------------------
# Full adresse til appen (brukes til Facebook-redirect og CSRF-kontroll)
APP_URL=https://din-app.vercel.app
# E-postadresse(r) som har lov til å logge inn (kommaseparert)
OWNER_EMAILS=eier@myhrtreogdesign.com
# 32 tilfeldige byte, base64. Lag med: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Minst 32 tegn. Vercel Cron sender denne som Bearer-token. Lag med: openssl rand -hex 32
CRON_SECRET=

# --- Anthropic (Claude) -------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Bildegenerering (valgfritt) ---------------------------------------------
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# --- Meta / Facebook ----------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
# Bruk nyeste stabile versjon fra https://developers.facebook.com/docs/graph-api/changelog
# (sjekk ved oppsett – eksempelet under kan være utdatert)
META_GRAPH_API_VERSION=v24.0
# Valgfritt: konfigurasjons-ID hvis appen bruker «Facebook Login for Business»
# (konfigurasjonen skal KUN inneholde pages_show_list, pages_manage_posts, pages_read_engagement)
META_LOGIN_CONFIG_ID=
# Valgfrie innsiktsmetrikker (kommaseparert). Metrikker Meta ikke tilbyr hoppes over.
# Se https://developers.facebook.com/docs/graph-api/reference/insights for gjeldende navn.
META_INSIGHTS_METRICS=

# --- Publisering ----------------------------------------------------------------
# "simulated" (standard) = ingenting sendes til Facebook. "live" = ekte publisering
# (krever i tillegg at testmodus er slått av under Innstillinger i appen).
PUBLISH_MODE=simulated
